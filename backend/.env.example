# Database Configuration
# For local development, leave commented to use SQLite
# DATABASE_URL=sqlite:///./ultimate_stats.db

# For production (Supabase/Railway PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database

# Frontend URL for CORS
# For local development
# FRONTEND_URL=http://localhost:5173

# For production (your Vercel URL)
# FRONTEND_URL=https://your-app.vercel.app

# Authentication Configuration
# Auth enforcement mode:
# - off: ignore auth and keep current behavior
# - shadow: resolve auth context without enforcing role checks
# - enforced: apply authentication and authorization checks
# AUTH_ENFORCEMENT_MODE=off
#
# Supabase project URL (shared with frontend)
# SUPABASE_URL=https://your-project.supabase.co

# Supabase JWKS endpoint for backend JWT verification
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Service role key for admin-only account management flows
# Keep this backend-only and never expose it to the frontend
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional first-admin bootstrap
# Use the Supabase auth user id (UUID) and email for the first admin account.
# When both values are set, startup will ensure a matching local admin record exists.
# INITIAL_ADMIN_AUTH_USER_ID=00000000-0000-0000-0000-000000000000
# INITIAL_ADMIN_EMAIL=admin@example.com
